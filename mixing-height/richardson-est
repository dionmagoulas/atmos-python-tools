import pandas as pd
import numpy as np
from scipy import stats

def calculate_richardson_mixing_height(csv_path: str, height_col: str, wind_col: str, temp_col: str, target_ri: float = 0.25, g: float = 9.81) -> tuple:
    """
    Διαβάζει μετεωρολογικά δεδομένα, υπολογίζει τον αριθμό Bulk Richardson (Ri) 
    για κάθε ύψος και βρίσκει το ύψος ανάμιξης μέσω γραμμικής παρεμβολής θεωρώντας κρίσιμη τιμή Ric = 0.25.

    Args:
        csv_path: Διαδρομή προς το αρχείο CSV.
        height_col: Όνομα στήλης υψομέτρου/ύψους (m).
        wind_col: Όνομα στήλης ταχύτητας ανέμου (m/s).
        temp_col: Όνομα στήλης (δυνητικής) θερμοκρασίας (K).
        target_ri: Η κρίσιμη τιμή του Ri (συνήθως 0.21 - 0.25).
        g: Επιτάχυνση της βαρύτητας (m/s^2).

    Returns:
        tuple: (DataFrame με [Ύψος, Ri], Εκτιμώμενο ύψος ανάμιξης)
    """
    try:
        df = pd.read_csv(csv_path)
    except FileNotFoundError:
        print(f"Σφάλμα: Το αρχείο '{csv_path}' δεν βρέθηκε.")
        return None, None

    # Έλεγχος στηλών
    required_cols = [height_col, wind_col, temp_col]
    if not all(col in data.columns for col in required_cols):
        print(f"Σφάλμα: Λείπουν απαραίτητες στήλες από το CSV. Απαιτούνται: {required_cols}")
        return None, None

    if data.empty:
        print("Σφάλμα: Το αρχείο CSV είναι άδειο.")
        return None, None

    # Η επιφανειακή θερμοκρασία λαμβάνεται από το πρώτο επίπεδο
    surftemp = df[temp_col].iloc[0]

    # Υπολογισμός Αριθμού Bulk Richardson
    # Σχέση: Ri = (g * z * (Θ(z) - Θs)) / (Θs * U(z)^2)
    # Προστέθηκε np.where για αποφυγή διαίρεσης με το μηδέν (όταν ταχύτητα ανέμου = 0)
    denominator = surftemp * (df[wind_col] ** 2)
    data['Ri'] = np.where(
        denominator != 0, 
        (g * df[height_col] * (df[temp_col] - surftemp)) / denominator, 
        np.nan
    )

    results = df[[height_col, 'Ri']].dropna().copy()

    if results.empty:
        print("Δεν υπάρχουν έγκυρα σημεία μετά τον υπολογισμό του Ri.")
        return results, None

    # Εύρεση του αμέσως μικρότερου και αμέσως μεγαλύτερου Ri σε σχέση με το target_ri
    # Φτιάχνω 2 νεα dataframe με τις τιμές μικρότερες του target_ri και μεγαλύτερες. 
    below = results[results['Ri'] < target_ri]
    above = results[results['Ri'] >= target_ri]

    # Μια λίστα που θελω τις 2 γραμμές με τα εκατέρωθεν του target_ri και τα αντίστοιχα ύψη 
    # Μετά ελέγχω τις αποστάσεις των Ri απο το target_ri για να βρώ την μικρότερη αρα και τα κοντινότερα Ri εκατέρωθεν. Παίρνω αυτές τις γραμμές δηλαδή και το ύψος και τις βάζω στην λίστα. 
    closest_points_list = []
    if not below.empty:
        closest_points_list.append(below.loc[(below['Ri'] - target_ri).abs().idxmin()])
    if not above.empty:
        closest_points_list.append(above.loc[(above['Ri'] - target_ri).abs().idxmin()])

    closest_points = pd.DataFrame(closest_points_list).drop_duplicates()

    # Για ασφάλεια τσεκάρω τις διαστάσεις της λίστας
    if closest_points.shape[0] < 2:
        if closest_points.shape[0] == 1 and closest_points['Ri'].iloc[0] == target_ri:
            return results, closest_points[height_col].iloc[0]
        print("Δεν βρέθηκαν επαρκή σημεία εκατέρωθεν του Target Ri για παρεμβολή.")
        return results, None

    if closest_points['Ri'].nunique() < 2:
        return results, closest_points[height_col].mean()

    # Γραμμική προσαρμογή (Height = slope * Ri + intercept)
    slope, intercept, r_value, _, _ = stats.linregress(closest_points['Ri'], closest_points[height_col])
    
    estimated_height = slope * target_ri + intercept
    
    print(f"--- Στατιστικά Παρεμβολής ---")
    print(f"R-squared: {r_value**2:.4f}")
    
    return results, estimated_height

